# Minimum seconds between requests to the same host (politeness).
SCRAPER_MIN_INTERVAL=1.0

# Honor robots.txt before fetching (strongly recommended).
SCRAPER_RESPECT_ROBOTS=true

# Default User-Agent. Identify your bot and give a contact URL.
SCRAPER_USER_AGENT=RoviDevBot/1.0 (+https://rovidev.com)

# Where JSON snapshots between runs are stored (for change detection).
SCRAPER_STATE_DIR=data/state

# Request timeout in seconds.
SCRAPER_TIMEOUT=10.0

# Google Sheets export (optional, requires the "sheets" extra).
# Path to a service-account JSON key and the target spreadsheet id.
SCRAPER_GOOGLE_CREDENTIALS=
SCRAPER_SHEET_ID=
